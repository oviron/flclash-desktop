<Project Sdk="Microsoft.NET.Sdk">
  <!-- The window of FlClash on Windows: WPF on the .NET Framework 4.8 that
       Windows 10 2004 and later carry, so the window brings no runtime of its
       own. It is started by FlClash.exe, the agent in the notification area,
       and talks to it over a named pipe; closing it ends the process.
       The styles are XAML read at start, not compiled, and the window is
       built in code: the project builds on any system with the .NET SDK. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <RootNamespace>FlClash</RootNamespace>
    <AssemblyName>FlClash.Window</AssemblyName>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- build.ps1 makes the icon from the picture all desktops use. -->
    <ApplicationIcon Condition="Exists('..\FlClash.ico')">..\FlClash.ico</ApplicationIcon>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="QRCoder" Version="1.9.0" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <!-- The strings every desktop app shows, shared with macOS. -->
    <EmbeddedResource Include="..\..\l10n\ru.lproj\Localizable.strings" Link="l10n\ru.strings" LogicalName="ru.strings" />
    <EmbeddedResource Include="..\..\l10n\ru.lproj\Localizable.stringsdict" Link="l10n\ru.stringsdict" LogicalName="ru.stringsdict" />
    <EmbeddedResource Include="..\..\l10n\en.lproj\Localizable.stringsdict" Link="l10n\en.stringsdict" LogicalName="en.stringsdict" />
    <EmbeddedResource Include="Theme.xaml" LogicalName="Theme.xaml" />
    <EmbeddedResource Include="..\FlClash.ico" Link="FlClash.ico" LogicalName="FlClash.ico" Condition="Exists('..\FlClash.ico')" />
  </ItemGroup>
</Project>
